# Owned source only. Do not normalize archived or generated data as code.
root = true

[{src,scripts,tools,tests}/**.{js,mjs,cjs,ts,css,html}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = false

[{src,tools,tests}/**.{cpp,cc,cxx,c,h,hpp,cpp.in,h.in}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = false

[{CMakeLists.txt,**/CMakeLists.txt,**.cmake}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true

# Embedded literals, fixtures and third-party files retain their source bytes.
[**/vendor/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[tests/fixtures/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[tools/historical-library/sources/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
